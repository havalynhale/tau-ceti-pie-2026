<?xml version="1.0" encoding="UTF-8"?>
<!--
  Makes the micro-ROS agent find other ROS programs ON THIS PC ONLY.

  Why: ROS programs normally find each other by broadcasting on the network
  (multicast). On some Wi-Fi networks (e.g. campus Wi-Fi) WSL's mirrored
  networking doesn't deliver those broadcasts, so programs take ~20 s or
  forever to see each other. Our ROS programs get the same fix from
  ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST in ~/.bashrc, but the agent ignores
  that variable, so it gets this file instead (set by display.launch.py).

  What it does: only use the 127.0.0.1 (this computer) network, and directly
  knock on the doors of the first 32 ROS programs on this computer instead of
  broadcasting.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>localhost_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
      <maxInitialPeersRange>32</maxInitialPeersRange>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="localhost_only" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>localhost_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
